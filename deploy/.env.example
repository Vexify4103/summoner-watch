# Copy to deploy/.env and fill in. deploy/.env is ignored by git: never commit it.

# "tunnel" starts the Cloudflare Tunnel container (Option A in deploy/README.md).
# Leave empty when you use your own reverse proxy (Option B).
COMPOSE_PROFILES=tunnel

# Token of your Cloudflare Tunnel (Networking > Tunnels). Keep it secret.
TUNNEL_TOKEN=

# Header with the real client IP: CF-Connecting-IP behind Cloudflare,
# X-Forwarded-For behind Caddy.
SUMMONER_RELAY_IP_HEADER=CF-Connecting-IP

# Small Pi (little free memory): build the relay on a PC instead and use
# deploy/Dockerfile.prebuilt. See "Low-memory Pi" in deploy/README.md.
RELAY_DOCKERFILE=deploy/Dockerfile

# Empty = public relay. For a private relay: output of `openssl rand -hex 16`.
SUMMONER_RELAY_KEY=
