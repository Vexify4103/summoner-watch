{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.vexify4103.summonerwatch",
  "Name": "Summoner Watch",
  "Version": "0.1.0.0",
  "Author": "Vexify4103",
  "Description": "Enemy summoner spell timers for League of Legends. Press when an enemy uses Flash, see the countdown, hear when it is back.",
  "URL": "https://github.com/Vexify4103/summoner-watch",
  "Icon": "imgs/plugin",
  "Category": "Summoner Watch",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/summoner-watch.exe",
  "CodePathWin": "bin/summoner-watch.exe",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "ApplicationsToMonitor": {
    "windows": [
      "League of Legends.exe"
    ]
  },
  "PropertyInspectorPath": "pi/settings.html",
  "Actions": [
    {
      "UUID": "com.vexify4103.summonerwatch.enemy",
      "Name": "Enemy",
      "Tooltip": "Tap: more important spell. Hold: other spell. Enemy top laner: double-tap = quest Teleport.",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.vexify4103.summonerwatch.dial",
      "Name": "Timer",
      "Tooltip": "Shows the Nth soonest running timer. On a dial: rotate = adjust 5s, push = cancel. On a key: tap = 5s less, hold = cancel.",
      "Icon": "imgs/action",
      "Controllers": [
        "Encoder",
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/dial.json",
        "TriggerDescription": {
          "Rotate": "Adjust timer 5s",
          "Push": "Cancel timer",
          "Touch": "Cancel timer"
        }
      },
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.vexify4103.summonerwatch.insight",
      "Name": "Cosmic Insight Edit",
      "Tooltip": "Tap, then tap an enemy key to toggle Cosmic Insight for that enemy.",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.vexify4103.summonerwatch.reset",
      "Name": "Undo / Reset",
      "Tooltip": "Tap: undo last started timer. Hold: clear all timers.",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}