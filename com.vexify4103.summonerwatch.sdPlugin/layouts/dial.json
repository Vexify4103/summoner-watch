{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "lol-timer-dial",
  "items": [
    { "key": "champ", "type": "pixmap", "rect": [6, 8, 56, 56] },
    { "key": "spell", "type": "pixmap", "rect": [66, 36, 28, 28] },
    {
      "key": "name",
      "type": "text",
      "rect": [98, 8, 98, 24],
      "font": { "size": 15, "weight": 600 },
      "alignment": "left",
      "text-overflow": "ellipsis"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [98, 32, 98, 36],
      "font": { "size": 28, "weight": 700 },
      "alignment": "left"
    },
    {
      "key": "bar",
      "type": "bar",
      "rect": [6, 76, 188, 14],
      "value": 0,
      "range": { "min": 0, "max": 100 },
      "bar_fill_c": "#e8b33a",
      "bar_bg_c": "#333333",
      "bar_border_c": "#555555",
      "border_w": 1
    }
  ]
}
